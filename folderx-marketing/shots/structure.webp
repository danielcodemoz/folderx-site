<svg width="1600" height="1000" viewBox="0 0 1600 1000" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="1600" height="1000" fill="#0f172a"/>
  
  <!-- Main Container -->
  <rect x="100" y="60" width="1400" height="880" rx="12" fill="#1e293b"/>
  
  <!-- Header -->
  <text x="140" y="130" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#f1f5f9">Estrutura de Pastas</text>
  <text x="140" y="165" font-family="Arial, sans-serif" font-size="16" fill="#94a3b8">projeto-web-template</text>
  
  <!-- Folder Tree -->
  <g transform="translate(140, 220)">
    <!-- Root folder -->
    <rect width="24" height="20" rx="3" fill="#14b8a6"/>
    <text x="35" y="17" font-family="monospace" font-size="18" font-weight="600" fill="#f1f5f9">project</text>
    
    <!-- Level 1 -->
    <line x1="12" y1="30" x2="12" y2="80" stroke="#334155" stroke-width="2"/>
    <line x1="12" y1="80" x2="40" y2="80" stroke="#334155" stroke-width="2"/>
    <rect x="40" y="70" width="24" height="20" rx="3" fill="#2dd4bf"/>
    <text x="75" y="87" font-family="monospace" font-size="18" font-weight="600" fill="#14b8a6">src</text>
    
    <!-- Level 2 - components -->
    <line x1="52" y1="100" x2="52" y2="150" stroke="#334155" stroke-width="2"/>
    <line x1="52" y1="150" x2="80" y2="150" stroke="#334155" stroke-width="2"/>
    <rect x="80" y="140" width="24" height="20" rx="3" fill="#2dd4bf"/>
    <text x="115" y="157" font-family="monospace" font-size="18" fill="#cbd5e1">components</text>
    
    <!-- Level 2 - assets -->
    <line x1="52" y1="150" x2="52" y2="200" stroke="#334155" stroke-width="2"/>
    <line x1="52" y1="200" x2="80" y2="200" stroke="#334155" stroke-width="2"/>
    <rect x="80" y="190" width="24" height="20" rx="3" fill="#14b8a6"/>
    <text x="115" y="207" font-family="monospace" font-size="18" fill="#cbd5e1">assets</text>
    
    <!-- Level 3 - images -->
    <line x1="92" y1="220" x2="92" y2="250" stroke="#334155" stroke-width="2"/>
    <line x1="92" y1="250" x2="120" y2="250" stroke="#334155" stroke-width="2"/>
    <rect x="120" y="240" width="24" height="20" rx="3" fill="#0d9488"/>
    <text x="155" y="257" font-family="monospace" font-size="16" fill="#94a3b8">images</text>
    
    <!-- Level 3 - css -->
    <line x1="92" y1="250" x2="92" y2="290" stroke="#334155" stroke-width="2"/>
    <line x1="92" y1="290" x2="120" y2="290" stroke="#334155" stroke-width="2"/>
    <rect x="120" y="280" width="24" height="20" rx="3" fill="#0d9488"/>
    <text x="155" y="297" font-family="monospace" font-size="16" fill="#94a3b8">css</text>
    
    <!-- Level 3 - fonts -->
    <line x1="92" y1="290" x2="92" y2="330" stroke="#334155" stroke-width="2"/>
    <line x1="92" y1="330" x2="120" y2="330" stroke="#334155" stroke-width="2"/>
    <rect x="120" y="320" width="24" height="20" rx="3" fill="#0d9488"/>
    <text x="155" y="337" font-family="monospace" font-size="16" fill="#94a3b8">fonts</text>
    
    <!-- Level 2 - utils -->
    <line x1="52" y1="200" x2="52" y2="380" stroke="#334155" stroke-width="2"/>
    <line x1="52" y1="380" x2="80" y2="380" stroke="#334155" stroke-width="2"/>
    <rect x="80" y="370" width="24" height="20" rx="3" fill="#14b8a6"/>
    <text x="115" y="387" font-family="monospace" font-size="18" fill="#cbd5e1">utils</text>
    
    <!-- Level 2 - pages -->
    <line x1="52" y1="380" x2="52" y2="430" stroke="#334155" stroke-width="2"/>
    <line x1="52" y1="430" x2="80" y2="430" stroke="#334155" stroke-width="2"/>
    <rect x="80" y="420" width="24" height="20" rx="3" fill="#14b8a6"/>
    <text x="115" y="437" font-family="monospace" font-size="18" fill="#cbd5e1">pages</text>
    
    <!-- Level 1 - public -->
    <line x1="12" y1="80" x2="12" y2="480" stroke="#334155" stroke-width="2"/>
    <line x1="12" y1="480" x2="40" y2="480" stroke="#334155" stroke-width="2"/>
    <rect x="40" y="470" width="24" height="20" rx="3" fill="#2dd4bf"/>
    <text x="75" y="487" font-family="monospace" font-size="18" font-weight="600" fill="#14b8a6">public</text>
    
    <!-- Level 1 - docs -->
    <line x1="12" y1="480" x2="12" y2="530" stroke="#334155" stroke-width="2"/>
    <line x1="12" y1="530" x2="40" y2="530" stroke="#334155" stroke-width="2"/>
    <rect x="40" y="520" width="24" height="20" rx="3" fill="#2dd4bf"/>
    <text x="75" y="537" font-family="monospace" font-size="18" font-weight="600" fill="#14b8a6">docs</text>
    
    <!-- Level 1 - tests -->
    <line x1="12" y1="530" x2="12" y2="570" stroke="#334155" stroke-width="2"/>
    <line x1="12" y1="570" x2="40" y2="570" stroke="#334155" stroke-width="2"/>
    <rect x="40" y="560" width="24" height="20" rx="3" fill="#2dd4bf"/>
    <text x="75" y="577" font-family="monospace" font-size="18" font-weight="600" fill="#14b8a6">tests</text>
  </g>
  
  <!-- Right Panel - Details -->
  <rect x="700" y="220" width="700" height="630" rx="8" fill="#0f172a"/>
  
  <text x="740" y="270" font-family="Arial, sans-serif" font-size="20" font-weight="600" fill="#f1f5f9">Detalhes da Estrutura</text>
  
  <text x="740" y="320" font-family="Arial, sans-serif" font-size="16" font-weight="600" fill="#2dd4bf">Total de pastas:</text>
  <text x="740" y="345" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#f1f5f9">15</text>
  
  <text x="740" y="400" font-family="Arial, sans-serif" font-size="16" font-weight="600" fill="#2dd4bf">Organização:</text>
  <rect x="740" y="420" width="600" height="30" rx="4" fill="#334155"/>
  <rect x="740" y="420" width="480" height="30" rx="4" fill="#14b8a6"/>
  <text x="960" y="442" font-family="Arial, sans-serif" font-size="14" font-weight="600" fill="#f1f5f9">80% Otimizada</text>
  
  <text x="740" y="490" font-family="Arial, sans-serif" font-size="16" font-weight="600" fill="#2dd4bf">Padrões aplicados:</text>
  
  <g transform="translate(740, 510)">
    <rect y="10" width="280" height="40" rx="6" fill="#334155"/>
    <text x="15" y="35" font-family="Arial, sans-serif" font-size="14" fill="#cbd5e1"> Separação de concerns</text>
    
    <rect y="60" width="280" height="40" rx="6" fill="#334155"/>
    <text x="15" y="85" font-family="Arial, sans-serif" font-size="14" fill="#cbd5e1"> Estrutura escalável</text>
    
    <rect y="110" width="280" height="40" rx="6" fill="#334155"/>
    <text x="15" y="135" font-family="Arial, sans-serif" font-size="14" fill="#cbd5e1"> Padrão da indústria</text>
  </g>
  
  <rect x="740" y="730" width="600" height="60" rx="8" fill="#14b8a6"/>
  <text x="890" y="767" font-family="Arial, sans-serif" font-size="18" font-weight="600" fill="#0f172a">Aplicar Template</text>
</svg>
