<svg width="1600" height="1000" viewBox="0 0 1600 1000" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Background -->
  <rect width="1600" height="1000" fill="#0f172a"/>
  
  <!-- Main Container -->
  <rect x="80" y="40" width="1440" height="920" rx="12" fill="#1e293b"/>
  
  <!-- Header -->
  <text x="120" y="100" font-family="Arial, sans-serif" font-size="32" font-weight="bold" fill="#f1f5f9">Outras Funcionalidades</text>
  <text x="120" y="135" font-family="Arial, sans-serif" font-size="16" fill="#94a3b8">Recursos avançados para otimizar seu fluxo de trabalho</text>
  
  <!-- Feature Grid -->
  <!-- Feature 1: Tags -->
  <g transform="translate(120, 180)">
    <rect width="420" height="200" rx="12" fill="#0f172a" stroke="#14b8a6" stroke-width="2"/>
    <circle cx="40" cy="40" r="25" fill="#14b8a6" opacity="0.2"/>
    <text x="40" y="48" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#14b8a6"><÷</text>
    
    <text x="80" y="47" font-family="Arial, sans-serif" font-size="20" font-weight="600" fill="#f1f5f9">Tags e rótulos</text>
    <text x="20" y="90" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">Organize projetos com</text>
    <text x="20" y="110" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">etiquetas personalizadas</text>
    
    <rect x="20" y="140" width="60" height="28" rx="14" fill="#14b8a6" opacity="0.2"/>
    <text x="50" y="159" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#14b8a6">Web</text>
    
    <rect x="90" y="140" width="70" height="28" rx="14" fill="#2dd4bf" opacity="0.2"/>
    <text x="125" y="159" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#2dd4bf">Mobile</text>
    
    <rect x="170" y="140" width="60" height="28" rx="14" fill="#0d9488" opacity="0.2"/>
    <text x="200" y="159" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#0d9488">API</text>
  </g>
  
  <!-- Feature 2: Search -->
  <g transform="translate(570, 180)">
    <rect width="420" height="200" rx="12" fill="#0f172a" stroke="#334155" stroke-width="2"/>
    <circle cx="40" cy="40" r="25" fill="#14b8a6" opacity="0.2"/>
    <text x="40" y="48" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#14b8a6">=</text>
    
    <text x="80" y="47" font-family="Arial, sans-serif" font-size="20" font-weight="600" fill="#f1f5f9">Busca rápida</text>
    <text x="20" y="90" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">Encontre projetos e</text>
    <text x="20" y="110" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">templates instantaneamente</text>
    
    <rect x="20" y="140" width="380" height="40" rx="8" fill="#334155"/>
    <text x="35" y="165" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">Buscar projeto...</text>
  </g>
  
  <!-- Feature 3: History -->
  <g transform="translate(1020, 180)">
    <rect width="420" height="200" rx="12" fill="#0f172a" stroke="#334155" stroke-width="2"/>
    <circle cx="40" cy="40" r="25" fill="#14b8a6" opacity="0.2"/>
    <text x="40" y="48" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#14b8a6">=Ü</text>
    
    <text x="80" y="47" font-family="Arial, sans-serif" font-size="20" font-weight="600" fill="#f1f5f9">Histórico</text>
    <text x="20" y="90" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">Acesse projetos recentes</text>
    <text x="20" y="110" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">com facilidade</text>
    
    <g transform="translate(20, 135)">
      <rect width="380" height="20" rx="4" fill="#334155"/>
      <rect width="320" height="20" rx="4" fill="#14b8a6" opacity="0.3"/>
      <text x="10" y="15" font-family="Arial, sans-serif" font-size="12" fill="#cbd5e1">projeto-web-2024</text>
    </g>
  </g>
  
  <!-- Feature 4: Export -->
  <g transform="translate(120, 410)">
    <rect width="420" height="200" rx="12" fill="#0f172a" stroke="#334155" stroke-width="2"/>
    <circle cx="40" cy="40" r="25" fill="#14b8a6" opacity="0.2"/>
    <text x="40" y="48" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#14b8a6">=¾</text>
    
    <text x="80" y="47" font-family="Arial, sans-serif" font-size="20" font-weight="600" fill="#f1f5f9">Exportar templates</text>
    <text x="20" y="90" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">Compartilhe suas</text>
    <text x="20" y="110" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">estruturas com a equipe</text>
    
    <rect x="20" y="140" width="180" height="40" rx="8" fill="#14b8a6"/>
    <text x="110" y="165" font-family="Arial, sans-serif" font-size="14" font-weight="600" text-anchor="middle" fill="#0f172a">Exportar JSON</text>
  </g>
  
  <!-- Feature 5: Shortcuts -->
  <g transform="translate(570, 410)">
    <rect width="420" height="200" rx="12" fill="#0f172a" stroke="#334155" stroke-width="2"/>
    <circle cx="40" cy="40" r="25" fill="#14b8a6" opacity="0.2"/>
    <text x="40" y="48" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#14b8a6">¡</text>
    
    <text x="80" y="47" font-family="Arial, sans-serif" font-size="20" font-weight="600" fill="#f1f5f9">Atalhos de teclado</text>
    <text x="20" y="90" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">Trabalhe mais rápido com</text>
    <text x="20" y="110" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">atalhos personalizados</text>
    
    <g transform="translate(20, 135)">
      <rect width="120" height="30" rx="6" fill="#334155"/>
      <text x="60" y="20" font-family="monospace" font-size="12" text-anchor="middle" fill="#cbd5e1">Ctrl + N</text>
      <text x="150" y="20" font-family="Arial, sans-serif" font-size="12" fill="#94a3b8">Novo projeto</text>
    </g>
  </g>
  
  <!-- Feature 6: Themes -->
  <g transform="translate(1020, 410)">
    <rect width="420" height="200" rx="12" fill="#0f172a" stroke="#334155" stroke-width="2"/>
    <circle cx="40" cy="40" r="25" fill="#14b8a6" opacity="0.2"/>
    <text x="40" y="48" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#14b8a6"><¨</text>
    
    <text x="80" y="47" font-family="Arial, sans-serif" font-size="20" font-weight="600" fill="#f1f5f9">Temas personalizados</text>
    <text x="20" y="90" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">Interface adaptável ao</text>
    <text x="20" y="110" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">seu estilo de trabalho</text>
    
    <g transform="translate(20, 135)">
      <circle cx="25" cy="25" r="20" fill="#14b8a6"/>
      <circle cx="75" cy="25" r="20" fill="#0f172a" stroke="#cbd5e1" stroke-width="2"/>
      <circle cx="125" cy="25" r="20" fill="#2dd4bf"/>
    </g>
  </g>
  
  <!-- Feature 7: Backup -->
  <g transform="translate(120, 640)">
    <rect width="420" height="200" rx="12" fill="#0f172a" stroke="#334155" stroke-width="2"/>
    <circle cx="40" cy="40" r="25" fill="#14b8a6" opacity="0.2"/>
    <text x="40" y="48" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#14b8a6"></text>
    
    <text x="80" y="47" font-family="Arial, sans-serif" font-size="20" font-weight="600" fill="#f1f5f9">Backup automático</text>
    <text x="20" y="90" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">Seus templates sempre</text>
    <text x="20" y="110" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">seguros e disponíveis</text>
    
    <rect x="20" y="140" width="380" height="8" rx="4" fill="#334155"/>
    <rect x="20" y="140" width="304" height="8" rx="4" fill="#14b8a6"/>
    <text x="200" y="165" font-family="Arial, sans-serif" font-size="12" text-anchor="middle" fill="#94a3b8">Último backup: hoje às 14:30</text>
  </g>
  
  <!-- Feature 8: Collaboration -->
  <g transform="translate(570, 640)">
    <rect width="420" height="200" rx="12" fill="#0f172a" stroke="#334155" stroke-width="2"/>
    <circle cx="40" cy="40" r="25" fill="#14b8a6" opacity="0.2"/>
    <text x="40" y="48" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#14b8a6">=e</text>
    
    <text x="80" y="47" font-family="Arial, sans-serif" font-size="20" font-weight="600" fill="#f1f5f9">Colaboração</text>
    <text x="20" y="90" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">Trabalhe em equipe com</text>
    <text x="20" y="110" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">templates compartilhados</text>
    
    <g transform="translate(20, 140)">
      <circle cx="20" cy="20" r="18" fill="#14b8a6"/>
      <circle cx="55" cy="20" r="18" fill="#2dd4bf"/>
      <circle cx="90" cy="20" r="18" fill="#0d9488"/>
      <text x="120" y="28" font-family="Arial, sans-serif" font-size="14" fill="#cbd5e1">+5 membros</text>
    </g>
  </g>
  
  <!-- Feature 9: Analytics -->
  <g transform="translate(1020, 640)">
    <rect width="420" height="200" rx="12" fill="#0f172a" stroke="#334155" stroke-width="2"/>
    <circle cx="40" cy="40" r="25" fill="#14b8a6" opacity="0.2"/>
    <text x="40" y="48" font-family="Arial, sans-serif" font-size="24" text-anchor="middle" fill="#14b8a6">=Ê</text>
    
    <text x="80" y="47" font-family="Arial, sans-serif" font-size="20" font-weight="600" fill="#f1f5f9">Estatísticas</text>
    <text x="20" y="90" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">Veja métricas de uso e</text>
    <text x="20" y="110" font-family="Arial, sans-serif" font-size="14" fill="#94a3b8">produtividade</text>
    
    <g transform="translate(20, 135)">
      <rect x="0" y="30" width="40" height="20" rx="2" fill="#14b8a6" opacity="0.6"/>
      <rect x="50" y="20" width="40" height="30" rx="2" fill="#14b8a6" opacity="0.8"/>
      <rect x="100" y="10" width="40" height="40" rx="2" fill="#14b8a6"/>
      <rect x="150" y="25" width="40" height="25" rx="2" fill="#14b8a6" opacity="0.7"/>
    </g>
  </g>
</svg>
